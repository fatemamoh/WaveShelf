<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>WaveShelf</title>
</head>
<body>
  <%- include('./partials/_navbar.ejs') %>

<div class="container">
<% if (user) { %>

<div class="user-hero-section">
    <div class="user-hero-text">
        <h1>Welcome back <%= user.username %>!</h1>
        <p>
            Welcome to your bookshelf dashboard. You can easily manage your reading lists and track your progress below.
        </p>

        <div class="action-buttons">
            <a href="/book/new" class="cta-button">
                 Add a New Book
            </a>
            
            <a href="/book" class="cta-button secondary-cta-btn">
                My Bookshelf
            </a>
        </div>
    </div>
</div>
    
<h3>Navigate your Book Progress </h3>
<div class="listContainer">
    <a href="/book/toRead">
        <img class="list-icon" src="/assets/bookPink.png" alt="To Read Icon">
        <span>To Read List</span>
    </a>
 
    <a href="/book/reading">
        <img class="list-icon" src="/assets/books.png" alt="Reading Icon">
        <span>Reading List</span>
    </a>
    
    <a href="/book/finished">
        <img class="list-icon" src="/assets/finished.png" alt="Finished Icon">
        <span>Finished List</span>
    </a>
</div>
<br>
<h3>Your Complete Bookshelf</h3>
<ul class="horizontal-list">
    <% Books.forEach((book)=> { %>
        <li class="bookCard">
            <a href="/book/<%= book._id%>"> 
                <img src="<%= book.image %>" alt="<%= book.title %> cover">
                <p><strong><%= book.title %></strong></p>
                <p><%= book.author %></p>
                <p>Status: <strong><span class="status-<%= book.status.toLowerCase().replace(/ /g, '') %>"><%= book.status %></span></strong></p>
                <% 
                    const total = book.totalPages;
                    const current = book.currentPage;
                    const percentage = (total && total > 0)
                        ? Math.round((current / total) * 100)
                        : 0;
                %>
                <% if (book.status === 'Reading') { %>
                    <progress value="<%= percentage %>" max="100"></progress>
                    <p style="font-size: 0.9rem;"><%= percentage %>% Read</p>
                <% } else if (book.status === 'Finished') { %>
                    <% if (book.reviews && book.reviews.length > 0) {
                        const latestReview = book.reviews[book.reviews.length - 1]; %>
                        <p style="font-size: 0.9rem;">(Rated <%= latestReview.rating %>/5)</p>
                    <% } else { %>
                        <p style="font-size: 0.9rem;">Reviewed: No</p>
                    <% } %>
                <% } %>
            </a>
        </li>
    <% }) %>
</ul>


<%  } else { %>
<div class="welcomeGuest">

<div class="hero-section">

<div class="hero-text">
<h1>WaveShelf</h1>
<h2>Track Every Page, Achieve Every Reading Goal </h2>
<p> Manage your reading 
lists, track your progress, save your favorite quotes, and 
set reading goals—all in one place.</p>
<a href="/auth/sign-up" class="cta-button"> Start Your Reading Journey → </a>
 </div>

  </div>

<section class="features-grid">
<h3>WaveShelf Key Features</h3>
<div class="feature-cards-container">
<div class="feature-card">
    <img class="feature-icon-img" src="/assets/shelf.png" alt="Book shelf icon">
    <h4>Track Progress</h4>
    <p>Effortlessly log every book and monitor your reading status across all lists.</p>
</div>
  
            <div class="feature-card">
                <img class="feature-icon-img" src="/assets/quote.png" alt="Bookmark icon for quotes">
    
                <h4>Save Quotes</h4>
                <p>Capture inspiring passages and personal thoughts instantly for review later.</p>
            </div>
            <div 
class="feature-card">
                <img class="feature-icon-img" src="/assets/review.png" alt="Review and rating icon">
               
                <h4>Write Reviews</h4>
                <p>Share your thoughts and rate books after finishing to keep a personal journal of your reads.</p>
            
</div>


</div>


</section>

<div class="login-link-footer">
        <p>Already have an account?
<a href="/auth/sign-in">Sign In</a></p>
    </div>
</div>

<% } %>
</div>
<footer>
    <p class="copyright">
    <span class="symbol">&copy;</span> 2025 WaveShelf
</p>
</footer>

</body>
</html>
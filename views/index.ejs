<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>WaveShelf</title>
</head>
<body>
  <%- include('./partials/_navbar.ejs') %>

<div class="container">
<% if (user) { %>
<div class="welcomeUser">
<h1>Welcome back <%= user.username %>!</h1>
<p>
Ready to update your bookshlef? Head over to your dashboard to update your progress,
 where you can have a reading session with a timer, 
add your favorite quoutes, or check your reading goals.
</p>
<a href="/book">My Bookshelf Dashboard → </a>
<hr>
<h4>want to add a book to your collection?</h4>
        <a href="/book/new"> → Add a new book</a>
<hr>
<h4>Navigate your Book Progress </h4>
  <div class="listContainer">
            
            <div> <a href="/book/toRead">To Read List</a> </div>
            <div><a href="/book/reading">Reading List</a></div>
            <div><a href="/book/finished">Finished List</a></div>
        </div>
 

</div>


<%  } else { %>
<div class="welcomeGuest">
  <div class="content">
    <div class="header">
<h1>WaveShelf</h1>
<h2> Book Tracker Website </h2>
<h3> Track your Reading Journey!</h3>

<div class="textContent">
  <div>
<img class="libraryImg" src="https://img.freepik.com/premium-photo/cozy-lofi-library-animestyle-peaceful-inviting_741402-15423.jpg?semt=ais_hybrid&w=740&q=80" alt="library">
  </div>
  <div><p>The best Website, where you can manage your reading lists, track your reading progress,
    easily save your favorite quotes and thoughts!
</p>
</div>

</div>


<a href="/auth/sign-up">
  Creat Your Account
</a>
<p>Already have an account? <a href="/auth/sign-in">Sign In</a></p>
</div>
</div>


<% } %>
<footer>
    <p class="copyright">
    <span class="symbol">&copy;</span> 2025 WaveShelf
</p>

</footer>

</div>
</body>
</html>
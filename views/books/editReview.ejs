<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Edit Review - <%= Books.title %></title>
</head>
<body>
<%- include('../partials/_navbar.ejs') %>
<div class="container">
    <h1>Edit Your Review</h1>
    <p>Book: <strong><%= Books.title %></strong></p>
    <a href="/book/<%= Books._id %>">← Cancel and Go Back</a>

    <form action="/book/<%= Books._id %>/review/<%= review._id %>?_method=PUT" method="POST" class="form-styling">
        <label for="rating">Rating (1-5):</label>
        <input type="number" id="rating" name="rating" min="1" max="5" value="<%= review.rating %>" required>

        <label for="reviewText">Your Review:</label>
        <textarea id="reviewText" name="reviewText" rows="10" required><%= review.reviewText %></textarea>

        <button type="submit" class="cta-button">Update Review</button>
    </form>
</div>
</body>
</html>
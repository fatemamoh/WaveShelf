<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>New Book</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <div class="container">
            <h1>Add a New Book!</h1>
            <form action="/book" method="POST">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" required="true">

                <label for="author">Author:</label>
                <input type="text" id="author" name="author" required="true">

                <label for="genre">Genre:</label>
                <select id="genre" name="genre" required>
                    <option value="Fiction">Fiction</option>
                    <option value="Non-Fiction">Non-Fiction</option>
                    <option value="Fantasy">Fantasy</option>
                    <option value="Mystery">Mystery</option>
                    <option value="Sci-Fi">Sci-Fi</option>
                    <option value="Romance">Romance</option>
                    <option value="Horror">Horror</option>
                    <option value="Biography">Biography</option>
                    <option value="History">History</option>
                </select>


                <label for="totalPages">Total Pages:</label>
                <input type="number" name="totalPages" id="totalPages" required min="1" max="1999">

                <label for="currentPage">Current Page:</label>
                <input type="number" name="currentPage" id="currentPage" min="1" value="1">

                <label for="mood">Mood:</label>

                <select id="mood" name="mood">
                    <option value="Thrilled">Thrilled</option>
                    <option value="Happy">Happy</option>
                    <option value="Excited">Excited</option>
                    <option value="Nostalgic">Nostalgic</option>
                    <option value="Heartbroken">Heartbroken</option>
                    <option value="Inspired">Inspired</option>
                    <option value="Bored">Bored</option>
                </select>

                <label for="status">Status:</label>
                <select name="status" id="status" required>
                    <option value="To Read" selected>To Read</option>

                    <option value="Reading">Reading</option>
                    <option value="Finished">Finished</option>
                </select>

                <label for="startDate">Start Date:</label>
                <input type="date" id="startDate" name="startDate" required="true">


                <label for="image">Book Cover Image URL</label>
                <input type="url" id="image" name="image" placeholder="Enter the book cover here" required>


                <button type="submit">Add Book</button>
            </form>
        </div>
</body>

</html>
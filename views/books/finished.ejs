<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Finished List</title>
</head>
<body>
        <%- include('../partials/_navbar.ejs') %>

      <% 
        const finishedBooks = Books.filter(book => book.status === 'Finished');
        %>

          <h2> Finished List (<%= finishedBooks.length %>) </h2>
         <div>
            <% if (finishedBooks.length > 0 ) { %>
            <ul>
                <% finishedBooks.forEach((book)=> { %>
                    <a href="/book/<%= book._id%>"> 
                    <div class="bookCard">
                    <img height="250px" src=<%=book.image %> alt="">
                    </div>
                    </a>
                                <li>
                        <p> Completed!</p>
                        <% if (book.reviews && book.reviews.length > 0) { %>
                        <% const latestReview = book.reviews[book.reviews.length - 1]; %>
                        (Rated <%= latestReview.rating %>/5)
            <%          } %>
                    </li>
                <% }) %>
            </ul>
            <% } else { %>
                <p>You haven't finished any book yet!</p>
                <% } %>
         </div>
   
</div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css">
    <title>Edit <%= Books.title %>
    </title>
</head>

<body>
<%- include('../partials/_navbar.ejs') %>
<div class="container">
    <h1>Edit a Book!</h1>
    <a href="/book/<%= Books._id %>">← Back to Book Details</a>
    <form action="/book/<%= Books._id %>?_method=PUT" method="POST">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" required value="<%= Books.title %>">
        <label for="author">Author:</label>
        <input type="text" id="author" name="author" required value="<%= Books.author %>">
        <label for="genre">Genre:</label>
        <input type="text" id="genre" name="genre" required value="<%= Books.genre %>">
        <label for="totalPages">Total Pages:</label>
        <input type="number" name="totalPages" id="totalPages" required value="<%= Books.totalPages %>">
        <label for="currentPage">Current Pages:</label>
        <input type="number" name="currentPage" id="currentPage" min="1" value="<%= Books.currentPage %>">
        <label for="mood">Mood:</label>
        <select id="mood" name="mood">
            <option value="Thrilled" <%=Books.mood==="Thrilled" ? "selected" : "" %>>Thrilled</option>
            <option value="Happy" <%=Books.mood==="Happy" ? "selected" : "" %>>Happy</option>
            <option value="Excited" <%=Books.mood==="Excited" ? "selected" : "" %>>Excited</option>
            <option value="Nostalgic" <%=Books.mood==="Nostalgic" ? "selected" : "" %>>Nostalgic</option>
            <option value="Heartbroken" <%=Books.mood==="Heartbroken" ? "selected" : "" %>>Heartbroken</option>
            <option value="Inspired" <%=Books.mood==="Inspired" ? "selected" : "" %>>Inspired</option>
            <option value="Bored" <%=Books.mood==="Bored" ? "selected" : "" %>>Bored</option>
        </select>
        <label for="status">Status:</label>
        <select id="status" name="status" required>
            <option value="To Read" <%=Books.status==="To Read" ? "selected" : "" %>>To Read</option>
            <option value="Reading" <%=Books.status==="Reading" ? "selected" : "" %>>Reading</option>
            <option value="Finished" <%=Books.status==="Finished" ? "selected" : "" %>>Finished</option>
        </select>
        <label for="startDate">Start Date:</label>
        <input type="date" id="startDate" name="startDate" required value="<%= Books.startDate.toISOString().slice(0, 10) %>">
        <label for="finishDate">Finish Date: </label>
        <input type="date" name="finishDate" id="finishDate" value="<%= Books.finishDate ? Books.finishDate.toISOString().split('T')[0] : '' %>">
        <input type="url" id="image" name="image" placeholder="Enter the book cover here" required value="<%= Books.image %>">
        <button type="submit"> Update Book</button>
    </form>
</div>
  <%- include('../partials/_footbar.ejs') %>
</body>

</html>
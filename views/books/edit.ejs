<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css">
    <title>Edit <%= Books.title %></title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
    <div class="container">
        <h1>Edit Book Details</h1>
        <a href="/book/<%= Books._id %>">← Cancel and Go Back</a>
        
        <form action="/book/<%= Books._id %>?_method=PUT" method="POST" class="form-styling">
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" required value="<%= Books.title %>">

            <label for="author">Author:</label>
            <input type="text" id="author" name="author" required value="<%= Books.author %>">

            <label for="genre">Genre:</label>
            <select id="genre" name="genre" required>
                <% const genres=['Fiction', 'Non-Fiction', 'Fantasy', 'Mystery', 'Sci-Fi', 'Romance', 'Horror', 'Biography', 'History']; %>
                <% genres.forEach(function(g) { %>
                    <option value="<%= g %>" <%= Books.genre === g ? 'selected' : '' %>><%= g %></option>
                <% }); %>
            </select>

            <label for="mood">Mood:</label>
            <select id="mood" name="mood" required>
                <% const moods=['Happy', 'Sad', 'Thrilled', 'Anxious', 'Relaxed', 'Heartbroken', 'Inspired', 'Bored']; %>
                <% moods.forEach(function(m) { %>
                    <option value="<%= m %>" <%= Books.mood === m ? 'selected' : '' %>><%= m %></option>
                <% }); %>
            </select>

            <label for="status">Status:</label>
            <select id="status" name="status" required>
                <option value="To Read" <%= Books.status === "To Read" ? "selected" : "" %>>To Read</option>
                <option value="Reading" <%= Books.status === "Reading" ? "selected" : "" %>>Reading</option>
                <option value="Finished" <%= Books.status === "Finished" ? "selected" : "" %>>Finished</option>
            </select>

            <label for="totalPages">Total Pages:</label>
            <input type="number" id="totalPages" name="totalPages" required value="<%= Books.totalPages %>">

            <label for="startDate">Start Date:</label>
            <input type="date" id="startDate" name="startDate" required value="<%= Books.startDate.toISOString().slice(0, 10) %>">

            <label for="finishDate">Finish Date:</label>
            <input type="date" name="finishDate" id="finishDate" value="<%= Books.finishDate ? Books.finishDate.toISOString().slice(0, 10) : '' %>">

            <label for="image">Cover Image URL:</label>
            <input type="url" id="image" name="image" required value="<%= Books.image %>">

            <button type="submit" class="cta-button">Update Book</button>
        </form>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Edit Quote - <%= Books.title %></title>
</head>
<body>
<%- include('../partials/_navbar.ejs') %>
<div class="container">
    <h1>Edit Quote</h1>
    <a href="/book/<%= Books._id %>">← Back to Details</a>

    <form action="/book/<%= Books._id %>/quotes/<%= quote._id %>?_method=PUT" method="POST" class="form-styling">
        <label for="quote">Quote Text:</label>
        <textarea id="quote" name="quote" rows="5" required><%= quote.quote %></textarea>

        <label for="pageNumber">Page Number:</label>
        <input type="number" id="pageNumber" name="pageNumber" value="<%= quote.pageNumber %>" required>

        <label for="emotion">Emotion:</label>
        <select id="emotion" name="emotion">
            <% const emotions = ['Amusement', 'Anger', 'Grief', 'Calm', 'Fear', 'Thrill', 'Nostalgic']; %>
            <% emotions.forEach(e => { %>
                <option value="<%= e %>" <%= quote.emotion === e ? 'selected' : '' %>><%= e %></option>
            <% }) %>
        </select>

        <label for="personalNote">Personal Note:</label>
        <textarea id="personalNote" name="personalNote" rows="3"><%= quote.personalNote %></textarea>

        <button type="submit" class="cta-button">Update Quote</button>
    </form>
</div>
</body>
</html>